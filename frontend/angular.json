{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "frontend": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:class": {
          "skipTests": true
        },
        "@schematics/angular:component": {
          "skipTests": true
        },
        "@schematics/angular:directive": {
          "skipTests": true
        },
        "@schematics/angular:guard": {
          "skipTests": true
        },
        "@schematics/angular:interceptor": {
          "skipTests": true
        },
        "@schematics/angular:pipe": {
          "skipTests": true
        },
        "@schematics/angular:resolver": {
          "skipTests": true
        },
        "@schematics/angular:service": {
          "skipTests": true
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/frontend",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "pdf.worker.mjs",
                "input": "../node_modules/pdfjs-dist/build",
                "output": "assets"
              },
              {
                "glob": "ort-wasm-simd-threaded.mjs",
                "input": "../node_modules/onnxruntime-web/dist",
                "output": "assets/ort"
              },
              {
                "glob": "ort-wasm-simd-threaded.wasm",
                "input": "../node_modules/onnxruntime-web/dist",
                "output": "assets/ort"
              },
              {
                "glob": "ort-wasm-simd-threaded.asyncify.mjs",
                "input": "../node_modules/onnxruntime-web/dist",
                "output": "assets/ort"
              },
              {
                "glob": "ort-wasm-simd-threaded.asyncify.wasm",
                "input": "../node_modules/onnxruntime-web/dist",
                "output": "assets/ort"
              },
              {
                "glob": "ort-wasm-simd-threaded.jsep.mjs",
                "input": "../node_modules/onnxruntime-web/dist",
                "output": "assets/ort"
              },
              {
                "glob": "ort-wasm-simd-threaded.jsep.wasm",
                "input": "../node_modules/onnxruntime-web/dist",
                "output": "assets/ort"
              },
              {
                "glob": "ort-wasm-simd-threaded.jspi.mjs",
                "input": "../node_modules/onnxruntime-web/dist",
                "output": "assets/ort"
              },
              {
                "glob": "ort-wasm-simd-threaded.jspi.wasm",
                "input": "../node_modules/onnxruntime-web/dist",
                "output": "assets/ort"
              }
            ],
            "styles": [
              "src/styles.css"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "550kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "10kB",
                  "maximumError": "16kB"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": true
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "web": {
              "fileReplacements": [
                {
                  "replace": "src/main.ts",
                  "with": "src/main.web.ts"
                }
              ]
            },
            "web-development": {
              "fileReplacements": [
                {
                  "replace": "src/main.ts",
                  "with": "src/main.web.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "frontend:build:production"
            },
            "development": {
              "buildTarget": "frontend:build:development"
            },
            "web": {
              "buildTarget": "frontend:build:production,web"
            },
            "web-development": {
              "buildTarget": "frontend:build:development,web-development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "tsconfig.spec.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/styles.css"
            ],
            "scripts": []
          }
        }
      }
    }
  }
}

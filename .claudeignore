# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/

# ── Build outputs ─────────────────────────────────────────────────────────────
# Compiled TypeScript (main process + scoring package)
dist/
# Angular production bundle
apps/ui/dist/
# Electron Forge packaged app & installers
out/
# TypeScript source maps — generated, not source-of-truth
*.js.map
*.d.ts.map

# ── Lock files ────────────────────────────────────────────────────────────────
# Large and auto-generated; not useful for code understanding
package-lock.json

# ── Secrets & environment ─────────────────────────────────────────────────────
.env
.env.*
*.pem

# ── User data (local runtime state, may contain PII) ─────────────────────────
# Resume files — personal/private
data/resume.pdf
data/resume.json
data/resume-for-mcp.txt
# Electron/Chromium runtime profile data
data/Cache/
data/Code Cache/
data/Cookies
data/Cookies-journal
data/DIPS
data/DIPS-wal
data/DawnGraphiteCache/
data/DawnWebGPUCache/
data/GPUCache/
data/Local State
data/Network Persistent State
data/Preferences
data/Service Worker/
data/Session Storage/
data/Shared Dictionary/
data/SharedStorage
data/SharedStorage-wal
data/SingletonCookie
data/SingletonLock
data/SingletonSocket
data/Trust Tokens
data/Trust Tokens-journal
data/WebStorage/
data/blob_storage/

# ── Binary assets ─────────────────────────────────────────────────────────────
resources/icon.icns
resources/icon.ico
resources/icon.png
resources/icon.iconset/

# ── Logs & runtime noise ──────────────────────────────────────────────────────
*.log
npm-debug.log*
*.pid
*.pid.lock


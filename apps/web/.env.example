# Copy to apps/web/.env for local development.
# Matches the services in docker-compose.yml.

NODE_ENV=development
PORT=3001
HOST=0.0.0.0

DATABASE_URL=postgres://resurank:resurank@localhost:5433/resurank

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-in-production

# Origin used to build links in verification and password-reset emails.
PUBLIC_URL=http://localhost:3001

# Leave COOKIE_DOMAIN unset for host-only cookies (correct for most setups).
# COOKIE_DOMAIN=.resurank.com

# Throttles. Auth covers credentials and mail; write covers authenticated
# app usage (resume uploads, saved scores, settings changes); global is the
# baseline for everything else, including the public GET /api/health.
# RATE_LIMIT_AUTH_MAX=5
# RATE_LIMIT_AUTH_WINDOW=15 minutes
# RATE_LIMIT_WRITE_MAX=60
# RATE_LIMIT_WRITE_WINDOW=1 minute
# RATE_LIMIT_GLOBAL_MAX=300
# RATE_LIMIT_GLOBAL_WINDOW=1 minute

# From address used no matter which mail path below sends the message.
EMAIL_FROM=ResuRank <no-reply@resurank.local>

# Set to send through Resend (https://resend.com) instead of SMTP — this is
# the only mail path production supports; config.ts fails fast at startup
# if NODE_ENV=production and this is unset. Leave unset in dev to send
# through Mailpit instead (see SMTP_* below), or set it to test Resend
# locally too.
# RESEND_API_KEY=

# SMTP fallback, used only when RESEND_API_KEY is unset. Defaults point at
# Mailpit — view mail sent here at http://localhost:8025.
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=

# Bootstrap admin, created (or re-promoted) on every server startup. Leave
# both unset if you don't want a seeded admin — you can still grant admin to
# an existing user through the admin panel once one exists.
#
# The password is env-owned: it is re-hashed into the database on every
# boot, so changing it in the app itself will be overwritten on the next
# restart. To rotate a leaked credential, change ADMIN_PASSWORD here (and
# ADMIN_EMAIL if you want a fresh account) and restart the server.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-and-rotate-this

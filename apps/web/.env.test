# Loaded automatically instead of .env when NODE_ENV=test (see src/config.ts
# and the "test" script in package.json). This is what makes `npm run test`
# always hit the docker-compose Postgres — apps/web/docker-compose.yml maps
# it to host port 5433 specifically so it never collides with a Postgres
# already running on the default 5432, which is what .env (local dev) may
# point at instead.
#
# No real secrets here — this only ever talks to the disposable local
# database from `npm run db:up`, so it's fine to commit.

NODE_ENV=test
DATABASE_URL=postgres://resurank:resurank@localhost:5433/resurank
SESSION_SECRET=test-only-session-secret-not-for-production-use

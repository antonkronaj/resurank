{
  "name": "@resurank/server",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-user web API for ResuRank — auth, Postgres CRUD, email, and static hosting of the web frontend build. Performs no ML; embedding and scoring stay client-side.",
  "license": "AGPL-3.0-only",
  "author": "Anton Kronaj <developer@kronaj.com>",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build:test && NODE_ENV=test node --test --test-concurrency=1 build-test/test/*.test.js",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput & node --watch dist/index.js",
    "clean": "rm -rf dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:test": "DATABASE_URL=postgres://resurank:resurank@localhost:5433/resurank drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.1.1",
    "@resurank/scoring": "^2.0.0",
    "argon2": "^0.41.1",
    "drizzle-orm": "^0.38.4",
    "fastify": "^5.2.1",
    "nodemailer": "^6.10.0",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.2",
    "typescript": "5.9.3"
  }
}

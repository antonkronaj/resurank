{
  "name": "resurank",
  "version": "0.1.10",
  "private": true,
  "description": "Resume to job-description matcher",
  "license": "AGPL-3.0-only",
  "main": "dist/src/main/index.js",
  "type": "module",
  "config": {
    "forge": "./forge.config.cjs"
  },
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "rebuild:native": "electron-rebuild -m backend",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build -- --base-href=./",
    "build:electron": "tsc -p src/tsconfig.json",
    "build": "npm run build:backend && npm run build:frontend && npm run build:electron",
    "dev:frontend": "npm --prefix frontend start",
    "dev:electron": "JOBDASH_DEV=1 npm run build:backend && npm run build:electron && npm run rebuild:native && JOBDASH_DEV=1 electron .",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "dist": "electron-forge make",
    "publish": "electron-forge publish",
    "make": "electron-forge make"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "electron-squirrel-startup": "^1.0.1",
    "electron-updater": "^6.8.3",
    "express": "^5.2.1",
    "multer": "^2.1.1",
    "natural": "^8.1.1",
    "pdf-parse": "^2.4.5",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-dmg": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/shared-types": "^7.11.1",
    "@electron/fuses": "^2.1.1",
    "@electron/rebuild": "^4.0.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.6.2",
    "electron": "^42.0.1",
    "tsx": "^4.21.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "karma": {
      "glob": "^7.2.3"
    }
  }
}

# apps/web/Dockerfile's build context is the repo root. Without this
# file, `COPY . .` copies the host's own node_modules over the image's
# freshly-`npm ci`'d one — breaking argon2's native binding, built for the
# host's OS/arch, not the alpine container's — and bakes local .env files
# (real DB/session/SMTP dev secrets) straight into an image layer.

node_modules
**/node_modules

# Build outputs — the Dockerfile builds these itself inside the container.
dist
**/dist
out
apps/ui/dist
**/build-test

# Real secrets — never belong in an image layer regardless of env-var
# precedence at runtime.
.env
**/.env
!**/.env.example

# Desktop-only / irrelevant to the server image.
resources
data
shared

# Repo metadata and tooling, not needed at runtime.
.git
.github
.idea
.claude
graphify-out
*.log

# Copy to packages/server/.env for local development.
# Matches the services in docker-compose.yml.

NODE_ENV=development
PORT=3001
HOST=0.0.0.0

DATABASE_URL=postgres://resurank:resurank@localhost:5433/resurank

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-in-production

# Origin used to build links in verification and password-reset emails.
PUBLIC_URL=http://localhost:3001

# Leave COOKIE_DOMAIN unset for host-only cookies (correct for most setups).
# COOKIE_DOMAIN=.resurank.com

# Throttles. Auth covers credentials and mail; write covers authenticated
# app usage (resume uploads, saved scores, settings changes); global is the
# baseline for everything else, including the public GET /api/health.
# RATE_LIMIT_AUTH_MAX=5
# RATE_LIMIT_AUTH_WINDOW=15 minutes
# RATE_LIMIT_WRITE_MAX=60
# RATE_LIMIT_WRITE_WINDOW=1 minute
# RATE_LIMIT_GLOBAL_MAX=300
# RATE_LIMIT_GLOBAL_WINDOW=1 minute

# Mailpit catches all outbound mail in dev — view it at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=ResuRank <no-reply@resurank.local>
# SMTP_USER=
# SMTP_PASS=
